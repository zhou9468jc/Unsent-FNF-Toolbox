    {
        "save": "disableCheckVer",
        "name": "Disable Engine Version Check",
        "type": "bool",
        "description": "If enabled, the script will no longer check whether the runtime environment is NovaFlare Engine. Under normal circumstances, \n*DO NOT* enable this option.",
        "value": false
    },
    {
        "save": "title2",
        "name": "Taunt Settings",
        "type": "string",
        "description": "Can taunt opponent...",
        "value": " ",
        "options":[" "]
    },
    {
	"save": "taunt",
	"name": "Taunt Key  :",
