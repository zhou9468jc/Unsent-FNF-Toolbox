[
    // All types:
    // Website : https://pastebin.com/raw/EMu20Fyx
    // bool - Has a checkbox only, meaning it can only be 'true' or 'false'.
    // int - Numbers with no decimals (ex. 1, 3, 9, -1)
    // float - Similar to int, but numbers can have decimals (ex. 1.5, 2.75)
    // percent - Similar to float, but the displayed value is multiplied by 100 (ex. 1.1 will be displayed as "110%")
    // string - A text instead of numbers/false and true, you gotta set up "options" variable to it
    // key - TO BE IMPLEMENTED
    {
        "save": "title1",
        "name": "Debug ToolBox Settings",
        "type": "string",
        "description": "Set your debug toolbox settings...",
        "value": " ",
        "options":[" "]
    },
    {
        "save": "developerMode",
        "name": "Enable Debug ToolBox",
        "type": "bool",
        "description": "If enabled, debugging shortcut keys can be used.",
        "value": false
    },
    {
        "save": "softPause",
        "name": "Soft Pause",
        "type": "bool",
        "description": "Enable Soft Pause. Hold SPACE and press H or G to Soft Pause the game without pausing scripts, then press SPACE to resume the game.",
        "value": false
    },
    {
        "save": "hideDevPrint",
        "name": "Hide Tools Debug Print",
        "type": "bool",
        "description": "If enabled, debug shortcut key prints will be hidden.",
        "value": false
    },
    {
        "save": "hideDevError",
        "name": "Hide Tools Error/Warn Prints",
        "type": "bool",
        "description": "If enabled, debug shortcut key error and warning prints will be hidden.",
