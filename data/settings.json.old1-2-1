    {
        "save": "tauntCharacter",
        "name": "   Taunt Character  :",
        "format": "   %v",
        "type": "string",
        "description": "Select which character plays the \"Hey\" animation.",
        "value": "BF",
        "options": [
            "BF",
            "GF",
            "Both"
        ]
    },
    {
        "save": "tauntDuration",
        "name": "   Taunt Duration  :",
        "type": "float",
        "format": "   %vs",
        "description": "Set how long the \"Hey\" animation lasts.",
        "value": 0.6,
        "decimals": 1,
        "min": 0.1,
        "max": 5,
        "step": 0.1,
        "scroll": 5
    },
    {
        "save": "tauntSoundVolume",
        "name": "   \"Hey\" Sound Volume  :",
        "format": "   %v%",
