    {
        "save": "developerMode",
        "name": "Enable Debug ToolBox",
        "type": "bool",
        "description": "如果启用，可以使用调试快捷键。",
        "value": false
    },
    {
        "save": "softPause",
        "name": "Soft Pause",
        "type": "bool",
        "description": "启用软暂停。按住 SPACE 并按 H 或 G 可以软暂停游戏而不暂停脚本，然后按 SPACE 恢复游戏。",
        "value": false
    },
    {
        "save": "playbackRateNoScrollSpeed",
        "name": "Independent Scroll Speed",
        "type": "bool",
        "description": "启用后，改变播放速度不会影响音符滚动速度。",
        "value": false
    },
    {
        "save": "hideDevPrint",
        "name": "Hide Tools Debug Print",
        "type": "bool",
        "description": "如果启用，调试快捷键的打印信息将被隐藏。",
        "value": false
    },
    {
        "save": "hideDevError",
        "name": "Hide Tools Error/Warn Prints",
        "type": "bool",
        "description": "如果启用，调试快捷键的错误和警告打印信息将被隐藏。",
        "value": false
    },
    {
        "save": "showBotText",
        "name": "Change Botplay Text",
        "type": "bool",
        "description": "如果禁用，使用此工具切换 Botplay 开关时将不会改变 \"botplayTxt.visible\" 状态。",
        "value": true
    },
    {
        "save": "showCaseMode",
        "name": "Showcase Mode",
        "type": "bool",
        "description": "启用录制展示模式。隐藏 HUD、判定信息、音弦，并隐藏判定音符。",
        "value": false
    },
